#!/usr/bin/env bash
set -euo pipefail

mode=${1:-}
device=${2:-}
object=${AORUS_HID_BPF_OBJECT:-/usr/local/lib/aorus-control/0010-Gigabyte__AERO-16-YE5.bpf.o}
enabled=/etc/aorus-control/brightness-hid-bpf.enabled
object_name=0010-Gigabyte__AERO-16-YE5.bpf
loaded_object_name=${object_name//[.:]/_}
descriptor_sha256=8c466c33cedbb3be04738089da3c09d4319443a793b462319708a8f8364be17a
fixed_descriptor_sha256=7c69146eea1d52d72015cdcc225e462e7110d4e5f8b26142986231c24a4f8271
legacy_brightness_descriptor_sha256=637f4bd5f31d413593ab1095e97f0567b4456c04e78bdb1268fc641e3e9e1a48

[[ $mode == add || $mode == test-add || $mode == remove || $mode == recover || $mode == status ]] || exit 2

dmi_matches() {
  [[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true) == GIGABYTE &&
    $(cat /sys/class/dmi/id/product_name 2>/dev/null || true) == 'AERO 16 YE5' &&
    $(cat /sys/class/dmi/id/product_version 2>/dev/null || true) == P86VE ]]
}

json_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s' "$value"
}

print_status() {
  local attached=$1
  local descriptor=$2
  local reason=$3
  printf '{"device":"%s","attached":%s,"object":"%s","descriptor_sha256":"%s","reason":"%s"}\n' \
    "$(json_escape "$device")" "$attached" "$object_name" "$descriptor" "$reason"
}

status_gate_failure() {
  local reason=$1
  if [[ $mode == status ]]; then
    print_status false "${descriptor:-unknown}" "$reason"
  fi
  exit 1
}

if [[ $device != /sys/* || ! ${device##*/} =~ ^0003:1044:7A3A\.[0-9A-Fa-f]+$ ]]; then
  if [[ $mode == status ]]; then
    print_status false unknown invalid-device
    exit 1
  fi
  exit 2
fi

if ! dmi_matches; then
  if [[ $mode == status ]]; then
    print_status false unknown dmi-mismatch
  fi
  exit 1
fi

if [[ -x /usr/local/libexec/aorus-udev-hid-bpf ]]; then
  loader=/usr/local/libexec/aorus-udev-hid-bpf
else
  loader=$(command -v udev-hid-bpf 2>/dev/null || true)
fi

if [[ $mode == status && ! -e $device ]]; then
  print_status false unknown device-missing
  exit 1
fi

if [[ $mode == remove && ! -e $device ]]; then
  # udev-hid-bpf accepts a vanished remove-event syspath. Restrict that case
  # to the physical USB interface-2 path selected by the udev rule.
  [[ $device =~ /[^/]+:1\.2/0003:1044:7A3A\.[0-9A-Fa-f]+$ ]]
  [[ -z $loader ]] || "$loader" remove "$device" >/dev/null 2>&1 || true
  exit 0
fi

[[ -e $device ]] || status_gate_failure device-missing
[[ $(cat "$device/uevent" 2>/dev/null | sed -n 's/^HID_ID=//p') == 0003:00001044:00007A3A ]] ||
  status_gate_failure hid-id-mismatch
[[ $(cat "$device/../bInterfaceNumber" 2>/dev/null || true) == 02 ]] ||
  status_gate_failure interface-mismatch
descriptor=$(sha256sum "$device/report_descriptor" 2>/dev/null | awk '{print $1}')
[[ $descriptor == "$descriptor_sha256" ||
   $descriptor == "$fixed_descriptor_sha256" ||
   $descriptor == "$legacy_brightness_descriptor_sha256" ]] ||
  status_gate_failure descriptor-mismatch

loaded_production() {
  [[ -n $loader ]] || return 1
  "$loader" list-loaded --syspath "$device" --format json 2>/dev/null |
    grep -F "\"name\": \"$loaded_object_name\"" >/dev/null
}

verify_attached() {
  local attempt
  for attempt in {1..20}; do
    if loaded_production && all_target_interfaces_are_generic; then
      return 0
    fi
    sleep 0.05
  done
  loaded_production || printf 'native Fn-key object %s is not pinned for %s\n' \
    "$loaded_object_name" "$device" >&2
  all_target_interfaces_are_generic || printf '%s\n' \
    'not every GIGABYTE keyboard interface is bound to hid-generic' >&2
  return 1
}

all_target_interfaces_are_generic() {
  local sibling driver found=0
  for sibling in /sys/bus/hid/devices/0003:1044:7A3A.*; do
    [[ -e $sibling ]] || continue
    [[ $(cat "$sibling/uevent" 2>/dev/null | sed -n 's/^HID_ID=//p') == 0003:00001044:00007A3A ]] || return 1
    driver=$(basename "$(readlink -f "$sibling/driver" 2>/dev/null || true)")
    [[ $driver == hid-generic ]] || return 1
    found=1
  done
  ((found == 1))
}

if [[ $mode == status ]]; then
  if [[ $descriptor == "$fixed_descriptor_sha256" ]]; then
    if loaded_production && all_target_interfaces_are_generic; then
      print_status true "$descriptor" attached
      exit 0
    elif ! loaded_production; then
      reason=production-object-not-listed
    else
      reason=non-generic-sibling
    fi
    print_status false "$descriptor" "$reason"
    exit 1
  fi
  if [[ $descriptor == "$legacy_brightness_descriptor_sha256" ]]; then
    reason=legacy-brightness-object-attached
  else
    reason=not-attached
  fi
  print_status false "$descriptor" "$reason"
  exit 1
fi

if [[ $mode == recover ]]; then
  if [[ -n $loader ]]; then
    "$loader" remove "$device" >/dev/null 2>&1 || true
  fi
  # Removing the descriptor fixup makes HID briefly reprobe. Give hid-generic
  # time to reappear before attempting a recovery bind, avoiding an EBUSY race.
  for _ in {1..20}; do
    [[ -L $device/driver ]] && break
    sleep 0.05
  done
  if [[ ! -L $device/driver ]]; then
    printf '%s\n' "${device##*/}" > /sys/bus/hid/drivers/hid-generic/bind || true
  fi
  [[ $(basename "$(readlink -f "$device/driver" 2>/dev/null)") == hid-generic ]]
  for _ in {1..40}; do
    descriptor=$(sha256sum "$device/report_descriptor" 2>/dev/null | awk '{print $1}')
    [[ $descriptor == "$descriptor_sha256" ]] && break
    sleep 0.05
  done
  [[ $descriptor == "$descriptor_sha256" ]]
  exit 0
fi

if [[ $mode == remove ]]; then
  [[ -n $loader ]] && "$loader" remove "$device" >/dev/null 2>&1 || true
  exit 0
fi

[[ -n $loader ]] || {
  logger -t aorus-brightness 'udev-hid-bpf is not installed; native Fn identities remain disabled'
  exit 0
}

if [[ $descriptor == "$fixed_descriptor_sha256" ]]; then
  verify_attached
  exit 0
fi

[[ $mode == test-add || -e $enabled ]] || exit 0
[[ -f $object ]] || exit 0
all_target_interfaces_are_generic

if [[ $descriptor == "$legacy_brightness_descriptor_sha256" ]]; then
  # Upgrade the former brightness-only attachment in place. The descriptor
  # must return to the exact source hash before the production object loads.
  "$loader" remove "$device" >/dev/null 2>&1 || true
  for _ in {1..40}; do
    descriptor=$(sha256sum "$device/report_descriptor" 2>/dev/null | awk '{print $1}')
    [[ $descriptor == "$descriptor_sha256" ]] && break
    sleep 0.05
  done
  [[ $descriptor == "$descriptor_sha256" ]]
  all_target_interfaces_are_generic
fi

[[ $descriptor == "$descriptor_sha256" ]]
if [[ $mode == test-add ]]; then
  "$loader" --debug --verbose add "$device" "$object"
else
  "$loader" add "$device" "$object"
fi
verify_attached

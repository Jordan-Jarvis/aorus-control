#!/usr/bin/env python3
"""
Sync Gigabyte AERO/AORUS fan profile mode with Pop!_OS/system76-power profile.

Clean integration points used:
  - com.system76.PowerDaemon PowerProfileSwitch signal
  - org.freedesktop.UPower.PowerProfiles ActiveProfile PropertiesChanged signal
  - org.freedesktop.login1 PrepareForSleep resume signal
  - org.freedesktop.UPower device AC/battery PropertiesChanged signals

Default mapping:
  performance / Performance -> fan_mode 2 (gaming)
  balanced / Balanced       -> fan_mode 0 (normal)
  power-saver / Battery     -> fan_mode 1 (silent)

This intentionally does not set a fixed fan speed.  The optional "force"
operation only re-selects fan profiles: it briefly switches to another safe
profile mode and then back to the mapped profile.  This works around the
out-of-tree aorus_laptop driver's cached fan_mode value becoming stale after
firmware/power/resume events; writing the same cached value can be ignored by
that driver even when the embedded controller is no longer in that mode.
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import Callable

BASE = Path("/sys/devices/platform/aorus_laptop")
CONF = Path("/etc/aorus-power-profile-sync.conf")

MODE_NAMES = {
    "0": "normal",
    "1": "silent",
    "2": "gaming",
    "3": "custom",
    "4": "auto",
    "5": "fixed",
}

# Friendly names accepted in /etc/aorus-power-profile-sync.conf.
MODE_NUMBERS = {v: k for k, v in MODE_NAMES.items()}

DEFAULT_MAP = {
    "performance": ("2", "gaming"),
    "Performance": ("2", "gaming"),
    "balanced": ("0", "normal"),
    "Balanced": ("0", "normal"),
    "power-saver": ("1", "silent"),
    "Battery": ("1", "silent"),
    "battery": ("1", "silent"),
}

# Ignore duplicate DBus signals that represent the same semantic profile change.
# system76-power and UPower normally both emit one signal for the same user action.
DUPLICATE_SIGNAL_WINDOW_SECONDS = 1.0

# Delay after resume/AC changes before reselecting the fan profile.  This gives
# firmware, system76-power, UPower, and the aorus_laptop sysfs nodes time to settle.
RESUME_REASSERT_DELAY_SECONDS = 4
POWER_REASSERT_DELAY_SECONDS = 2

# Low-noise periodic guard: DBus signals are the primary mechanism, but the
# embedded controller/driver stack can drift. This only repairs mismatches
# between the selected power profile and fan profile; it does not set fixed RPM
# or change the Pop!_OS/system76 power profile.
WATCHDOG_RECONCILE_INTERVAL_SECONDS = 60

_last_signal: tuple[str, float] | None = None
_pending_timers: dict[str, int] = {}


def log(msg: str) -> None:
    print(msg, flush=True)


def normalize_profile(profile: str | None) -> str | None:
    if profile is None:
        return None
    profile = str(profile).strip().strip('"')
    if not profile:
        return None
    aliases = {
        "Performance": "performance",
        "Balanced": "balanced",
        "Battery": "power-saver",
        "battery": "power-saver",
    }
    return aliases.get(profile, profile)


def read_config() -> dict[str, tuple[str, str]]:
    """Read optional KEY=fan_mode mappings from /etc/aorus-power-profile-sync.conf."""
    mapping = dict(DEFAULT_MAP)
    if not CONF.exists():
        return mapping

    for lineno, line in enumerate(CONF.read_text(errors="replace").splitlines(), start=1):
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = [x.strip() for x in line.split("=", 1)]
        if not key:
            continue

        # Accept either fan_mode number or friendly mode name.
        value = MODE_NUMBERS.get(value, value)
        if value not in MODE_NAMES:
            log(
                f"Ignoring invalid config mapping on {CONF}:{lineno}: {key}={value!r}; "
                "expected 0..5 or normal/silent/gaming/custom/auto/fixed"
            )
            continue
        mapping[key] = (value, MODE_NAMES[value])

    return mapping


def mapped_mode(profile: str | None) -> tuple[str, str] | None:
    if not profile:
        return None
    mapping = read_config()
    if profile in mapping:
        return mapping[profile]
    normalized = normalize_profile(profile)
    if normalized and normalized in mapping:
        return mapping[normalized]
    return None


def wait_for_driver(timeout: float = 30.0) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if (BASE / "fan_mode").exists():
            return True
        time.sleep(0.25)
    return (BASE / "fan_mode").exists()


def run_text(cmd: list[str]) -> str:
    return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL).strip()


def parse_busctl_string(text: str) -> str | None:
    # busctl returns: s "Performance" or s "performance"
    m = re.search(r'"(.*)"', text)
    if m:
        return m.group(1)
    parts = text.split()
    return parts[-1] if parts else None


def current_profile() -> str | None:
    # Prefer system76-power's native profile names.
    try:
        return parse_busctl_string(run_text([
            "busctl", "call", "--system",
            "com.system76.PowerDaemon",
            "/com/system76/PowerDaemon",
            "com.system76.PowerDaemon",
            "GetProfile",
        ]))
    except Exception:
        pass

    # Fallback to the standardized power-profiles interface.
    try:
        return parse_busctl_string(run_text([
            "busctl", "get-property", "--system",
            "org.freedesktop.UPower.PowerProfiles",
            "/org/freedesktop/UPower/PowerProfiles",
            "org.freedesktop.UPower.PowerProfiles",
            "ActiveProfile",
        ]))
    except Exception:
        pass

    # Last fallback: CLI parse.
    try:
        out = run_text(["system76-power", "profile"])
        m = re.search(r"Power Profile:\s*(\S+)", out)
        return m.group(1) if m else None
    except Exception:
        return None


def read_fan_mode() -> str:
    try:
        return (BASE / "fan_mode").read_text().strip()
    except Exception:
        return "unknown"


def intermediate_profile_mode(target_mode: str) -> tuple[str, str] | None:
    """Choose a temporary fan profile mode to force the driver to resend target.

    Only profile modes are used here: normal/silent/gaming.  No fixed fan speed
    or custom speed is set.  Avoid forcing through custom/auto/fixed modes so the
    service remains profile-based and does not alter fan curves/speeds.
    """
    if target_mode == "0":
        return "2", "gaming"  # briefly higher cooling, then back to normal
    if target_mode == "1":
        return "0", "normal"  # avoid a loud gaming spike for silent profile
    if target_mode == "2":
        return "0", "normal"  # makes the later gaming write non-identical
    # If the user maps a profile to custom/auto/fixed, do not guess a force path.
    return None


def write_fan_mode(mode: str) -> None:
    (BASE / "fan_mode").write_text(mode + "\n")


def apply_profile(
    profile: str | None,
    *,
    dry_run: bool = False,
    force_reselect: bool = False,
    reason: str = "profile",
) -> int:
    if not profile:
        log(f"No power profile detected for {reason}; not changing fan profile")
        return 1

    selected = mapped_mode(profile)
    if selected is None:
        log(f"No fan mapping for power profile {profile!r}; not changing fan profile")
        return 1

    mode, name = selected
    fan_mode = BASE / "fan_mode"
    if not fan_mode.exists():
        log(f"{fan_mode} does not exist; is aorus_laptop loaded?")
        return 1

    old = read_fan_mode()
    prefix = "Would map" if dry_run else "Mapped"

    if force_reselect:
        intermediate = intermediate_profile_mode(mode)
        if intermediate is None:
            # Preserve support for user-configured custom/auto/fixed mappings, but
            # do not invent a force path for them.
            if dry_run:
                log(
                    f"Would map profile {profile!r} -> fan_mode {mode} ({name}); "
                    f"force reselect skipped for non-basic profile mode; current fan_mode={old}"
                )
                return 0
            write_fan_mode(mode)
            log(
                f"Mapped profile {profile!r} -> fan_mode {mode} ({name}); "
                f"force reselect skipped for non-basic profile mode; previous fan_mode={old}; reason={reason}"
            )
            return 0

        inter_mode, inter_name = intermediate
        if dry_run:
            log(
                f"Would force-reselect profile {profile!r}: fan_mode {inter_mode} ({inter_name}) "
                f"then {mode} ({name}); current fan_mode={old}; reason={reason}"
            )
            return 0

        write_fan_mode(inter_mode)
        time.sleep(0.35)
        write_fan_mode(mode)
        log(
            f"Force-reselected profile {profile!r}: fan_mode {inter_mode} ({inter_name}) "
            f"then {mode} ({name}); previous fan_mode={old}; reason={reason}"
        )
        return 0

    if dry_run:
        log(f"Would map profile {profile!r} -> fan_mode {mode} ({name}); current fan_mode={old}; reason={reason}")
        return 0

    write_fan_mode(mode)
    log(f"Mapped profile {profile!r} -> fan_mode {mode} ({name}); previous fan_mode={old}; reason={reason}")
    return 0


def apply_current(*, force_reselect: bool, reason: str) -> int:
    return apply_profile(current_profile(), force_reselect=force_reselect, reason=reason)


def reconcile_current_profile(reason: str = "watchdog") -> int:
    """Repair fan profile only when sysfs fan_mode disagrees with power profile.

    This keeps logs and kernel warnings quiet during normal operation.  It also
    avoids overriding user intent: Balanced remains normal, Performance remains
    gaming, Battery/power-saver remains silent according to the config mapping.
    """
    profile = current_profile()
    selected = mapped_mode(profile)
    if selected is None:
        return 1

    desired_mode, desired_name = selected
    fan_mode = BASE / "fan_mode"
    if not fan_mode.exists():
        log(f"{fan_mode} does not exist during {reason}; is aorus_laptop loaded?")
        return 1

    current = read_fan_mode()
    if current == desired_mode:
        return 0

    log(
        f"Watchdog repairing fan profile mismatch: power profile {profile!r} expects "
        f"fan_mode {desired_mode} ({desired_name}) but current fan_mode={current}"
    )
    return apply_profile(profile, force_reselect=False, reason=reason)


def is_duplicate_profile_signal(profile: str | None) -> bool:
    global _last_signal
    normalized = normalize_profile(profile) or str(profile)
    now = time.monotonic()
    if _last_signal is not None:
        last_profile, last_time = _last_signal
        if normalized == last_profile and (now - last_time) < DUPLICATE_SIGNAL_WINDOW_SECONDS:
            return True
    _last_signal = (normalized, now)
    return False


def watch() -> int:
    # Try to ensure module is loaded if service starts before modules-load did it.
    if not (BASE / "fan_mode").exists():
        subprocess.run(["modprobe", "aorus-laptop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    if not wait_for_driver():
        log("aorus_laptop sysfs fan controls not available after waiting")
        return 1

    apply_current(force_reselect=False, reason="service-start")

    try:
        import dbus
        import dbus.mainloop.glib
        from gi.repository import GLib
    except Exception as e:
        log(f"Python DBus/GLib imports failed: {e}")
        return 1

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()

    def schedule_current_force(key: str, delay_seconds: int, reason: str) -> None:
        old_timer = _pending_timers.pop(key, None)
        if old_timer is not None:
            try:
                GLib.source_remove(old_timer)
            except Exception:
                pass

        def _run() -> bool:
            _pending_timers.pop(key, None)
            apply_current(force_reselect=True, reason=reason)
            return False

        _pending_timers[key] = GLib.timeout_add_seconds(delay_seconds, _run)
        log(f"Scheduled profile reselect in {delay_seconds}s; reason={reason}")

    def on_system76_power_switch(profile):
        profile = str(profile)
        if is_duplicate_profile_signal(profile):
            log(f"Ignoring duplicate profile signal {profile!r} from system76-power")
            return
        apply_profile(profile, reason="system76 PowerProfileSwitch")

    def on_ppd_props_changed(interface, changed, invalidated):
        try:
            if "ActiveProfile" in changed:
                profile = str(changed["ActiveProfile"])
                if is_duplicate_profile_signal(profile):
                    log(f"Ignoring duplicate profile signal {profile!r} from UPower PowerProfiles")
                    return
                apply_profile(profile, reason="UPower PowerProfiles ActiveProfile")
        except Exception as e:
            log(f"Failed handling PowerProfiles PropertiesChanged: {e}")

    def on_prepare_for_sleep(sleeping):
        # logind emits True before sleep and False after resume.
        try:
            if not bool(sleeping):
                schedule_current_force("resume", RESUME_REASSERT_DELAY_SECONDS, "resume")
        except Exception as e:
            log(f"Failed handling PrepareForSleep: {e}")

    def schedule_watchdog() -> None:
        def _run() -> bool:
            try:
                reconcile_current_profile(reason="watchdog")
            except Exception as e:
                log(f"Failed handling watchdog reconcile: {e}")
            return True

        GLib.timeout_add_seconds(WATCHDOG_RECONCILE_INTERVAL_SECONDS, _run)
        log(f"Scheduled fan profile watchdog every {WATCHDOG_RECONCILE_INTERVAL_SECONDS}s")

    def on_upower_device_props_changed(interface, changed, invalidated, path=None):
        try:
            # AC online and battery state changes are common times for firmware to
            # re-evaluate thermal policy.  Re-select the mapped profile shortly after.
            interesting = {"Online", "State"}
            if interesting.intersection(str(k) for k in changed.keys()):
                schedule_current_force("upower-device", POWER_REASSERT_DELAY_SECONDS, f"UPower device change {path}")
        except Exception as e:
            log(f"Failed handling UPower device PropertiesChanged: {e}")

    bus.add_signal_receiver(
        on_system76_power_switch,
        signal_name="PowerProfileSwitch",
        dbus_interface="com.system76.PowerDaemon",
        bus_name="com.system76.PowerDaemon",
        path="/com/system76/PowerDaemon",
    )

    bus.add_signal_receiver(
        on_ppd_props_changed,
        signal_name="PropertiesChanged",
        dbus_interface="org.freedesktop.DBus.Properties",
        bus_name="org.freedesktop.UPower.PowerProfiles",
        path="/org/freedesktop/UPower/PowerProfiles",
        arg0="org.freedesktop.UPower.PowerProfiles",
    )

    bus.add_signal_receiver(
        on_prepare_for_sleep,
        signal_name="PrepareForSleep",
        dbus_interface="org.freedesktop.login1.Manager",
        bus_name="org.freedesktop.login1",
        path="/org/freedesktop/login1",
    )

    bus.add_signal_receiver(
        on_upower_device_props_changed,
        signal_name="PropertiesChanged",
        dbus_interface="org.freedesktop.DBus.Properties",
        bus_name="org.freedesktop.UPower",
        arg0="org.freedesktop.UPower.Device",
        path_keyword="path",
    )

    schedule_watchdog()
    log("Watching system76-power / PowerProfiles / logind resume / UPower AC-battery signals")
    GLib.MainLoop().run()
    return 0


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("command", choices=["apply", "force", "watch", "dry-run", "profile"], nargs="?", default="apply")
    args = p.parse_args()

    prof = current_profile()
    if args.command == "profile":
        print(prof or "unknown")
        return 0 if prof else 1
    if args.command == "dry-run":
        return apply_profile(prof, dry_run=True, force_reselect=True, reason="dry-run")
    if args.command == "apply":
        if not wait_for_driver(timeout=1.0):
            subprocess.run(["modprobe", "aorus-laptop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            wait_for_driver(timeout=5.0)
        return apply_profile(prof, reason="manual apply")
    if args.command == "force":
        if not wait_for_driver(timeout=1.0):
            subprocess.run(["modprobe", "aorus-laptop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            wait_for_driver(timeout=5.0)
        return apply_profile(prof, force_reselect=True, reason="manual force")
    if args.command == "watch":
        return watch()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

[Unit]
Description=Sync Gigabyte AERO/AORUS fan mode with Pop!_OS power profile
Documentation=https://github.com/tangalbert919/gigabyte-laptop-wmi
After=systemd-modules-load.service com.system76.PowerDaemon.service
Wants=com.system76.PowerDaemon.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/aorus-power-profile-sync watch
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
